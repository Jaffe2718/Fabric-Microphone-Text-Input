    "suggests": {
        "modmenu": "*"
    },
    "custom": {
        "modmenu": {
            "links": {
                "mcmti.modrinth": "https://modrinth.com/mod/mcmti",
                "mcmti.whisperjni": "https://github.com/GiviMAD/whisper-jni",
                "mcmti.huggingface.ggerganov.whisper_cpp.model": "https://huggingface.co/ggerganov/whisper.cpp/tree/main"
            },
            "update_checker": true
        }
